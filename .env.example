# Copy this file to ".env" and fill in the values you need.
# Every setting has a sensible default, so the tracker runs even with an empty .env.

# ---------------------------------------------------------------------------
# Scraping politeness
# ---------------------------------------------------------------------------
# Base delay (seconds) between consecutive product requests.
REQUEST_DELAY=2.0
# Extra random delay (0..REQUEST_JITTER seconds) added on top of REQUEST_DELAY
# so the request pattern is not perfectly periodic.
REQUEST_JITTER=1.0
# Per-request network timeout in seconds.
REQUEST_TIMEOUT=20
# How many times to retry a request that fails with HTTP 429 / 5xx.
MAX_RETRIES=3
# User-Agent sent with every request. Identify yourself honestly.
USER_AGENT=price-tracker-bot/1.0 (+https://github.com/NavenduChaturvedi/Price-tracker)

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DB_PATH=price_history.db

# ---------------------------------------------------------------------------
# Alerts
# ---------------------------------------------------------------------------
# One of: auto, telegram, email, none
#   auto  -> use telegram if configured, else email, else just print
ALERT_METHOD=auto

# Telegram (recommended - quickest to demo).
# 1. Talk to @BotFather to create a bot and get the token.
# 2. Send your bot a message, then read the chat id from
#    https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP). Example values are for Gmail with an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
